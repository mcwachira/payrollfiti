# Branding — configurable app name, no hardcoding in code
APP_NAME=PayrollFiti

# Default country for tenants that don't specify one (KE, NG, ZA)
COUNTRY_DEFAULT=KE

# --- Database (docker-compose defaults; override for local/managed Postgres) ---
POSTGRES_USER=payrollfiti
POSTGRES_PASSWORD=payrollfiti
POSTGRES_DB=payrollfiti
DATABASE_URL=postgresql://payrollfiti:payrollfiti@localhost:5432/payrollfiti

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- API ---
PORT=3000
CORS_ORIGIN=http://localhost:3001
# This API's own public origin — used to build OAuth redirect_uri values
# (accounting integrations below) that QuickBooks/Xero/Zoho Books redirect
# back to. Different from CORS_ORIGIN, which is the frontend's origin.
API_PUBLIC_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
PAYSLIP_STORAGE_DIR=./storage/payslips
DOCUMENT_STORAGE_DIR=./storage/documents

# --- Rate limiting (requests per window, per IP) ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Billing: Paystack ---
PAYSTACK_SECRET_KEY=

# --- Payments: M-Pesa (Daraja) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
# Shared secret appended to the callback URL's query string — Safaricom does
# not sign STK push callbacks, so this is how payment-webhooks/mpesa rejects
# spoofed requests.
MPESA_CALLBACK_TOKEN=

# --- Notifications: SMTP (nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PayrollFiti <noreply@payrollfiti.com>"

# --- Notifications: SMS (Africa's Talking) — optional, falls back to a no-op provider if unset ---
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=

# --- Notifications: Web Push — optional, falls back to a no-op provider if unset.
# Generate a pair with `npx web-push generate-vapid-keys`. The public key is
# not a secret; the private key is. VAPID_SUBJECT should be a mailto: or
# https: URL push services may contact if your traffic looks abusive. ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@payrollfiti.com

# --- Accounting sync: QuickBooks, Xero, Zoho Books — optional, each falls back
# to "not connected" (Settings just shows it as unavailable) if its own
# CLIENT_ID/CLIENT_SECRET pair is unset. Register an OAuth2 app with each
# platform and set its redirect URI to:
#   {API_PUBLIC_URL}/accounting/integrations/callback/QUICKBOOKS (or XERO / ZOHO_BOOKS)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
# Zoho's accounts/API hosts are region-specific: com, eu, in, com.au, jp.
ZOHO_BOOKS_REGION=com

# --- Error tracking (Sentry) — optional, no-op if unset ---
SENTRY_DSN=

# --- Field-level encryption (KRA PIN, NSSF/NHIF numbers, bank account numbers) ---
# 64-hex-char (32-byte) AES-256-GCM key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be set in any non-development environment — falls back to an insecure
# dev-only key otherwise.
ENCRYPTION_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PayrollFiti
# Canonical production origin — drives metadataBase, canonical URLs, the
# sitemap, and JSON-LD. Set to the real domain once one is live.
NEXT_PUBLIC_SITE_URL=https://payrollfiti.com
