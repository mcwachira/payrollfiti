# Branding — configurable app name, no hardcoding in code
APP_NAME=PayrollFiti

# Default country for tenants that don't specify one (KE, NG, ZA)
COUNTRY_DEFAULT=KE

# --- Database (docker-compose defaults; override for local/managed Postgres) ---
POSTGRES_USER=payrollfiti
POSTGRES_PASSWORD=payrollfiti
POSTGRES_DB=payrollfiti
DATABASE_URL=postgresql://payrollfiti:payrollfiti@localhost:5432/payrollfiti

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- API ---
PORT=3000
CORS_ORIGIN=http://localhost:3001
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
PAYSLIP_STORAGE_DIR=./storage/payslips

# --- Rate limiting (requests per window, per IP) ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Billing: Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Payments: M-Pesa (Daraja) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=

# --- Field-level encryption (KRA PIN, NSSF/NHIF numbers, bank account numbers) ---
# 64-hex-char (32-byte) AES-256-GCM key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be set in any non-development environment — falls back to an insecure
# dev-only key otherwise.
ENCRYPTION_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PayrollFiti
