# Copy to .env.local for standalone `pnpm --filter web dev` (outside docker-compose).
# Both vars have safe localhost defaults in lib/config.ts if omitted.

# Base URL of the NestJS API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Branding shown before a tenant's own branding config loads
NEXT_PUBLIC_APP_NAME=PayrollFiti
