APP_NAME=PayrollFiti
APP_ENV=local
APP_KEY=
# Generate with: php artisan key:generate --show
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Default country for tenants that don't specify one (KE, NG, ZA)
COUNTRY_DEFAULT=KE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the `db` service in docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=payrollfiti
DB_USERNAME=payrollfiti
DB_PASSWORD=payrollfiti

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to the real domain (no scheme, no port) once nginx is the public
# entry point — e.g. payrollfiti.com. "null" is fine while on localhost.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

# Matches the `redis` service hostname in docker-compose.yml.
# predis is a pure-PHP client — no PHP extension to install in the
# Dockerfile, unlike phpredis. Requires: composer require predis/predis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@payrollfiti.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Auth (Sanctum) ---
# Domains allowed to authenticate via cookie-based SPA auth. With nginx
# proxying both api and web on one origin, this is usually just that origin.
SANCTUM_STATEFUL_DOMAINS=localhost

# Only needed if something calls the API directly, bypassing the nginx
# reverse proxy (which puts api + web on one origin and avoids CORS).
CORS_ALLOWED_ORIGINS=http://localhost

PAYSLIP_STORAGE_DIR=/var/www/storage/payslips
DOCUMENT_STORAGE_DIR=/var/www/storage/documents

# --- Rate limiting (requests per window, per IP) ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Billing: Paystack ---
PAYSTACK_SECRET_KEY=

# --- Payments: M-Pesa (Daraja) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
# Shared secret appended to the callback URL's query string — Safaricom does
# not sign STK push callbacks, so this is how the callback route rejects
# spoofed requests.
MPESA_CALLBACK_TOKEN=

# --- Notifications: SMS (Africa's Talking) — optional, falls back to a no-op provider if unset ---
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=

# --- Notifications: Web Push — optional, falls back to a no-op provider if unset.
# Generate a pair with `npx web-push generate-vapid-keys`. The public key is
# not a secret; the private key is. VAPID_SUBJECT should be a mailto: or
# https: URL push services may contact if your traffic looks abusive. ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@payrollfiti.com

# --- Accounting sync: QuickBooks, Xero, Zoho Books — optional, each falls back
# to "not connected" if its own CLIENT_ID/CLIENT_SECRET pair is unset.
# Register an OAuth2 app with each platform and set its redirect URI to:
#   {APP_URL}/api/accounting/integrations/callback/QUICKBOOKS (or XERO / ZOHO_BOOKS)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
# Zoho's accounts/API hosts are region-specific: com, eu, in, com.au, jp.
ZOHO_BOOKS_REGION=com

# --- Blog (Sanity CMS) — optional; blog-admin routes and public /blog
# endpoints return empty until SANITY_PROJECT_ID is set.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
# The ONE tenant allowed to manage the blog (a per-tenant ADMIN role alone
# would let any customer tenant's admin write to it) — sign up your own
# account, find its tenant id, and set it here. Unset means nobody can
# manage the blog.
PLATFORM_TENANT_ID=

# --- Error tracking (Sentry) — optional, no-op if unset ---
SENTRY_LARAVEL_DSN=

# --- Field-level encryption (KRA PIN, NSSF/NHIF numbers, bank account numbers) ---
# 64-hex-char (32-byte) AES-256-GCM key. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# MUST be set in any non-development environment.
ENCRYPTION_KEY=
